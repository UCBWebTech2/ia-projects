@using PFEstudioJuridico.DTOs
@model DocumentoDetalleDTO

@{
    ViewData["Title"] = "Detalles del Documento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mb-4" style="margin: auto; max-width: 50rem;">
    <div class="card-header py-3 bg-primary text-white">
        <h6 class="m-0 font-weight-bold">Detalles del Documento</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5>Información del Documento</h5>
                <ul class="list-group">
                    <li class="list-group-item"><strong>Nombre:</strong> @Model.NombreDocumento</li>
                    <li class="list-group-item"><strong>Tipo:</strong> @Model.TipoDocumento</li>
                    <li class="list-group-item"><strong>Subido por:</strong> @Model.NombreUsuario</li>
                    <li class="list-group-item"><strong>Subido en:</strong> @Model.FechaSubida.ToShortDateString()</li>
                    <li class="list-group-item"><strong>Estado:</strong> @(Model.Habilitado ? "Habilitado" : "Deshabilitado")</li>
                    <li class="list-group-item"><strong>Predicción IA:</strong> @(Model.PrediccionIa ?? "N/D")</li>
                    <li class="list-group-item"><strong>Confianza IA:</strong> @(Model.ConfianzaIa.HasValue ? Model.ConfianzaIa.Value.ToString("P2") : "N/D")</li>
                    <li class="list-group-item"><strong>Versión modelo:</strong> @(Model.VersionModelo ?? "N/D")</li>
                    <li class="list-group-item"><strong>Categoría confirmada:</strong> @(Model.CategoriaConfirmadaId?.ToString() ?? "Sin confirmar")</li>
                </ul>

                <form asp-action="ConfirmarPrediccion" asp-controller="Documento" method="post" class="mt-3">
                    <input type="hidden" name="idDocumento" value="@Model.IdDocumento" />
                    <div class="form-group">
                        <label for="idCategoriaConfirmada">Confirmar categoría (ID)</label>
                        <input type="number" class="form-control" id="idCategoriaConfirmada" name="idCategoriaConfirmada" required />
                    </div>
                    <button type="submit" class="btn btn-success btn-sm mt-2">Confirmar predicción</button>
                </form>
            </div>
            <div class="col-md-6">
                <h5>Entidades / NER</h5>
                @{ var ents = (Model.Entidades != null && Model.Entidades.Any()) ? Model.Entidades : Model.Indices; }
                @if (ents != null && ents.Any())
                {
                    <ul class="list-group" style="max-height:420px; overflow:auto;">
                        @foreach (var entidad in ents)
                        {
                            var tipo = entidad.TipoTermino ?? "";
                            var label = tipo switch {
                                "PER" => "Persona", "LOC" => "Lugar", "ORG" => "Organización",
                                "INSTITUCION" => "Institución", "LEY" => "Ley", "ARTICULO" => "Artículo",
                                "INSTRUMENTO" => "Instrumento", "DEMANDANTE" => "Demandante", "DEMANDADO" => "Demandado",
                                "JUEZ" => "Juez", "FISCAL" => "Fiscal", "ABOGADO" => "Abogado",
                                "NRO_PROCESO" => "Nro. Proceso", "JUZGADO" => "Juzgado", "FECHA_AUDIENCIA" => "Fecha audiencia",
                                _ => tipo
                            };
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><span class="badge badge-info mr-2">@label</span>@entidad.Termino</span>
                                <small class="text-muted">@entidad.Frecuencia</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-info">No hay entidades relacionadas.</div>
                }
            </div>
        </div>
    </div>
    <div class="card-footer text-right">
        @* <a href="@Url.Action("Editar", "Documentos", new { id = Model.IdDocumento })" class="btn btn-warning">Editar</a>
        <a href="@Url.Action("Eliminar", "Documentos", new { id = Model.IdDocumento })" class="btn btn-danger">Eliminar</a> *@
        <a href="@Url.Action("Index", "Documento")" class="btn btn-secondary">Volver</a>
    </div>
</div>

