@using PFEstudioJuridico.Models.DTOs;
@model List<DocumentoDTO>

@{
    ViewData["Title"] = "Documento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="@Url.Content("~/vendor/datatables/dataTables.bootstrap4.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/vendor/datatables/extensiones/css/responsive.dataTables.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/vendor/datatables/extensiones/css/buttons.dataTables.min.css")">
    <style>
        td, th {
            word-wrap: break-word;
        }
        td {
            max-height: 50px;
            overflow: hidden;
        }

        .acciones-botones .accion-btn {
            margin-right: 4px;
        }

            .acciones-botones .accion-btn:last-child {
                margin-right: 0;
            }
    </style>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade" role="alert">
        <strong>¡Éxito!</strong> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>¡Aviso!</strong> @TempData["Warning"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade" role="alert">
        <strong>¡Error!</strong> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Documentos</h6>
    </div>
    <div class="card-body">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["Mensaje"]
            </div>
        }

        <div class="row mb-3">
            <div class="col-sm-6 d-flex align-items-center gap-2">
                <button class="btn btn-success mr-2" data-toggle="modal" data-target="#modalData" onclick="nuevoDocumento()">
                    <i class="fas fa-plus-circle"></i> Nuevo Documento
                </button>
                <button class="btn btn-warning mr-2" data-toggle="modal" data-target="#modalInstruccionesOCR">
                    <i class="fas fa-info-circle"></i> Recomendaciones OCR
                </button>
                <button class="btn btn-primary" onclick="window.location.href='@Url.Action("BusquedaAvanzada", "Documento")'">
                    <i class="fas fa-search"></i> Búsqueda Avanzada
                </button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 mb-2">
                <label class="small font-weight-bold mb-1" for="filtroCategoriaDoc">Categoría</label>
                <select id="filtroCategoriaDoc" class="form-control form-control-sm">
                    <option value="">Todas</option>
                    @foreach (var categoria in ViewBag.Categorias)
                    {
                        <option value="@categoria.NombreCategoria">@categoria.NombreCategoria</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <label class="small font-weight-bold mb-1" for="filtroProcesoDoc">Proceso</label>
                <select id="filtroProcesoDoc" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    @foreach (var proceso in ViewBag.Procesos)
                    {
                        <option value="@proceso.NombreProceso">@proceso.NombreProceso</option>
                    }
                </select>
            </div>
            @if (User.IsInRole("Administrador"))
            {
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroEstadoDoc">Estado</label>
                    <select id="filtroEstadoDoc" class="form-control form-control-sm">
                        <option value="">Todos</option>
                        <option value="Visible">Visible</option>
                        <option value="No Visible">No Visible</option>
                    </select>
                </div>
            }
            <div class="col-md-3 mb-2 d-flex align-items-end">
                <button type="button" id="btnLimpiarFiltrosDoc" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-eraser"></i> Limpiar filtros
                </button>
            </div>
        </div>

        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Subido por</th>
                            <th>Categoria</th>
                            <th>Proceso</th>
                            @if (User.IsInRole("Administrador"))
                            {
                                <th>Habilitado</th>
                            }
                            <th>Fecha de Registro</th>
                            <th class="text-nowrap" style="min-width: 150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var documento in Model)
                            {
                                if (User.IsInRole("Abogado") && !documento.Habilitado)
                                {
                                    continue;
                                }
                                <tr>
                                    <td>@documento.NombreDocumento</td>
                                    <td>@documento.TipoDocumento</td>
                                    <td>@documento.NombreUsuario</td>
                                    <td>@documento.NombreCategoria</td>
                                    <td>@documento.NombreProceso</td>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <td>
                                            @if (documento.Habilitado)
                                            {
                                                <span class="badge badge-info">Visible</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">No Visible</span>
                                            }
                                        </td>
                                    }
                                    <td>@(documento.FechaCreacion.HasValue ? documento.FechaCreacion.Value.ToString("dd/MM/yyyy") : "No especificada")</td>
                                    <td class="text-nowrap acciones-td">
                                        <div class="d-flex flex-nowrap align-items-center acciones-botones">

                                            <button class="btn btn-primary btn-sm accion-btn"
                                                    data-toggle="modal"
                                                    data-target="#modalData"
                                                    onclick="editarDocumento(@documento.IdDoc,'@documento.NombreDocumento','@documento.TipoDocumento',@documento.IdProceso,@documento.IdCategoria,@documento.Habilitado.ToString().ToLower())"
                                                    title="Editar">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>

                                            <a class="btn btn-info btn-sm accion-btn"
                                               href="@Url.Action("DetallesDocumento", "Documento", new { id = documento.IdDoc })"
                                               title="Detalles">
                                                <i class="fas fa-info-circle"></i>
                                            </a>

                                            @if (!string.IsNullOrEmpty(documento.RutaDocumento))
                                            {
                                                if (documento.RutaDocumento.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <!-- Firebase -->
                                                    <a class="btn btn-info btn-sm accion-btn"
                                                       href="@documento.RutaDocumento"
                                                       target="_blank"
                                                       title="Descargar documento">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <!-- Supabase -->
                                                    <a class="btn btn-info btn-sm accion-btn"
                                                       asp-controller="Documento"
                                                       asp-action="Abrir"
                                                       asp-route-id="@documento.IdDoc"
                                                       target="_blank"
                                                       title="Descargar documento">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                }
                                            }

                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a class="btn @(documento.Habilitado ? "btn-success" : "btn-danger") btn-sm accion-btn"
                                                   href="@Url.Action("CambiarEstado", "Documento", new { id = documento.IdDoc })"
                                                   title="Cambiar estado">
                                                    <i class="fas @(documento.Habilitado ? "fa-eye" : "fa-eye-slash")"></i>
                                                </a>
                                            }
                                            else if (User.IsInRole("Abogado"))
                                            {
                                                <a class="btn btn-danger btn-sm accion-btn"
                                                   href="@Url.Action("CambiarEstado", "Documento", new { id = documento.IdDoc })"
                                                   title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">No se encontraron documentos.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Documento -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 id="modalTitle">Nuevo Documento</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentoForm" method="post" enctype="multipart/form-data">
                    <input type="hidden" id="txtId" name="IdDocumento" value="0">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-row">
                                <div class="form-group col-sm-12">
                                    <label for="archivo">Archivo</label>
                                    <input type="file" class="form-control-file" id="archivo" name="archivo">
                                    <small class="form-text text-muted">Por favor, sube un archivo válido (opcional para editar).</small>
                                </div>
                                <div class="form-group col-sm-12">
                                    <label for="txtNombre">Nombre del Documento</label>
                                    <input type="text" class="form-control form-control-sm" id="txtNombre" name="NombreDocumento" required>
                                </div>
                                <div class="form-group col-sm-12">
                                    @* <label for="txtTipo">Tipo de Documento</label> *@
                                    <input type="hidden" class="form-control form-control-sm" id="txtTipo" name="TipoDocumento" required>
                                </div>
                                <div class="form-group col-sm-12">
                                    <label for="selectProceso">Seleccionar Proceso</label>
                                    <select id="selectProceso" name="IdProceso" class="form-control">
                                        <option value="">-- Sin proceso asociado --</option>
                                        @foreach (var proceso in ViewBag.Procesos)
                                        {
                                            <option value="@proceso.IdProceso">@proceso.NombreProceso</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group col-sm-12">
                                    <label for="selectCategoria">Seleccionar Categoría</label>
                                    <select id="selectCategoria" name="IdCategoria" class="form-control" required>
                                        <option value="">-- Selecciona una Categoría --</option>
                                        @foreach (var categoria in ViewBag.Categorias)
                                        {
                                            <option value="@categoria.IdCategoria">@categoria.NombreCategoria</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="ddlHabilitado">Habilitado</label>
                                    <select class="form-control form-control-sm" id="ddlHabilitado" name="Habilitado" required>
                                        <option value="true">Habilitado</option>
                                        <option value="false">No habilitado</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal de Instrucciones para el OCR -->
<div class="modal fade" id="modalInstruccionesOCR" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" role="document" style="max-width: 600px;">
        <div class="modal-content" style="max-height: 90vh; overflow-y: auto;">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-lightbulb"></i> Recomendaciones para subir imágenes legibles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>1. Buena iluminación:</strong> Asegúrate de que la imagen esté bien iluminada y sin sombras que cubran el texto.
                    </li>
                    <li class="list-group-item">
                        <strong>2. Imagen nítida:</strong> Evita fotografías borrosas o con movimiento. Usa la cámara con enfoque automático si es posible.
                    </li>
                    <li class="list-group-item">
                        <strong>3. Texto horizontal:</strong> La imagen debe estar en orientación horizontal o vertical sin estar rotada o inclinada.
                    </li>
                    <li class="list-group-item">
                        <strong>4. Márgenes completos:</strong> Captura toda la hoja o documento, sin cortar texto en los bordes.
                    </li>
                    <li class="list-group-item">
                        <strong>5. Fondo claro:</strong> Evita fondos oscuros, reflejos o manchas que puedan interferir con el texto.
                    </li>
                    <li class="list-group-item">
                        <strong>6. Resolución adecuada:</strong> Usa imágenes de al menos 300 DPI o una foto que supere los 1000 píxeles de ancho.
                    </li>
                </ul>
                <div class="mt-3 text-center">
                    <img src="/images/querella1.jpg" class="img-fluid rounded shadow-sm"
                         style="max-width: 300px; max-height: 400px;" alt="Ejemplo OCR" />
                    <small class="form-text text-muted mt-2">Ejemplo de imagen ideal para extracción OCR.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@{
    var tieneSuccess = TempData.ContainsKey("Success")
        .ToString()
        .ToLowerInvariant();

    var tieneError = TempData.ContainsKey("Error")
        .ToString()
        .ToLowerInvariant();
}

<div id="tempDataFlagsDocumento"
     data-success="@tieneSuccess"
     data-error="@tieneError"
     style="display:none">
</div>
@section scripts {
    <script src="@Url.Content("~/vendor/datatables/extensiones/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables/extensiones/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables/extensiones/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables/extensiones/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables/extensiones/js/buttons.print.min.js")"></script>

    <script>
        function nuevoDocumento() {
            $('#documentoForm')[0].reset(); // Restablecer el formulario
            $('#txtId').val(0); // Indica que es un nuevo documento
            $('#modalTitle').text('Nuevo Documento');
            $('#documentoForm').attr('action', '/Documento/SubirDocumento'); // Endpoint para creación
        }
        function editarDocumento(id, nombre, tipo, proceso, categoria, habilitado) {
            console.log("Datos recibidos para editar:", { id, nombre, tipo, proceso, categoria, habilitado });
            $('#txtId').val(id); // ID del documento
            $('#txtNombre').val(nombre); // Nombre del documento
            $('#txtTipo').val(tipo); // Tipo del documento
            $('#selectProceso').val(proceso); // Proceso seleccionado
            $('#selectCategoria').val(categoria); // Categoría seleccionada
            $('#ddlHabilitado').val(habilitado ? 'true' : 'false'); // Convertir a cadena para el select
            $('#modalTitle').text('Editar Documento'); // Cambia el título del modal
            $('#documentoForm').attr('action', `/Documento/ActualizarDocumento/${id}`); // Configura la acción
        }

        $(document).ready(function () {
            var table = $('#tbdata').DataTable({
                paging: true,
                lengthMenu: [10, 25, 50, 75, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                }
            });

            function colIdx(name) {
                var idx = -1;
                table.columns().every(function (i) {
                    var h = ($(this.header()).text() || '').trim();
                    if (h === name) idx = i;
                });
                return idx;
            }
            var catCol = colIdx('Categoria');
            var procCol = colIdx('Proceso');
            var habCol = colIdx('Habilitado');

            $('#filtroCategoriaDoc').on('change', function () { if (catCol > -1) table.column(catCol).search(this.value).draw(); });
            $('#filtroProcesoDoc').on('change', function () { if (procCol > -1) table.column(procCol).search(this.value).draw(); });
            $('#filtroEstadoDoc').on('change', function () { if (habCol > -1) table.column(habCol).search(this.value).draw(); });
            $('#btnLimpiarFiltrosDoc').on('click', function () {
                $('#filtroCategoriaDoc, #filtroProcesoDoc, #filtroEstadoDoc').val('');
                table.columns().search('').draw();
            });
        });
        // $('#modalData').on('show.bs.modal', function () {
        //     document.getElementById('txtTipo').value = ""; // Limpia el campo de tipo al abrir el modal
        // });
        $(document).ready(function () {
            // Verificar si existe un mensaje de éxito en TempData
            const flagsDocumento = $("#tempDataFlagsDocumento");

            const tieneSuccess = flagsDocumento.data("success") === true ||
                                 flagsDocumento.data("success") === "true";

            const tieneError = flagsDocumento.data("error") === true ||
                               flagsDocumento.data("error") === "true";

            if (tieneSuccess) {
                // Mostrar la alerta al cargarse la página
                $(".alert-success").addClass("show");
                setTimeout(function () {
                    $(".alert-success").fadeOut("slow", function() {
                        $(this).removeClass("show").addClass("fade");
                    });
                }, 5000); // 5000 milisegundos = 5 segundos
            }

            // Verificar si existe un mensaje de error en TempData
            if (tieneError) {
                // Mostrar la alerta al cargarse la página
                $(".alert-danger").addClass("show");
                setTimeout(function () {
                    $(".alert-danger").fadeOut("slow", function() {
                        $(this).removeClass("show").addClass("fade");
                    });
                }, 5000); // 5000 milisegundos = 5 segundos
            }
        });
        document.getElementById('archivo').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const txtNombre = document.getElementById('txtNombre');
                const txtTipo = document.getElementById('txtTipo');

                const fileName = file.name;
                const fileExtension = file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';

                const extensionMap = {
                    'pdf': 'PDF',
                    'docx': 'DOCX',
                    'doc': 'DOC',
                    'jpg': 'JPG',
                    'jpeg': 'JPG',
                    'png': 'PNG'
                };
                const tipoDocumento = extensionMap[fileExtension] || 'Otro';

                // Asigna valores a los campos correspondientes
                txtNombre.value = fileName;
                txtTipo.value = tipoDocumento;

            }
        });

        function confirmarCambioEstado(url) {
            swal({
                title: "¿Estás seguro?",
                text: "¿Deseas cambiar el estado de este documento?",
                icon: "warning",
                buttons: {
                    cancel: {
                        text: "Cancelar",
                        value: null,
                        visible: true,
                        className: "btn btn-secondary",
                        closeModal: true,
                    },
                    confirm: {
                        text: "Aceptar",
                        value: true,
                        visible: true,
                        className: "btn btn-success",
                        closeModal: true,
                    }
                },
                closeOnClickOutside: false,
                buttonsStyling: false
            }).then((willChange) => {
                if (willChange) {
                    // Redirige a la URL generada para ejecutar la acción
                    window.location.href = url;
                }
            });
        }
        function confirmarBorrarDocumento(url) {
            swal({
                title: "¿Estás seguro?",
                text: "Una vez eliminado, no podrás recuperar este documento.",
                icon: "warning",
                buttons: {
                    cancel: {
                        text: "Cancelar",
                        value: null,
                        visible: true,
                        className: "btn btn-secondary",
                        closeModal: true,
                    },
                    confirm: {
                        text: "Aceptar",
                        value: true,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
                closeOnClickOutside: false,
                buttonsStyling: false
            }).then((willDelete) => {
                if (willDelete) {
                    // Realizar la llamada AJAX para enviar el POST
                    $.ajax({
                        type: "POST", // Cambiar el método a POST
                        url: url, // URL generada por Url.Action
                        success: function (response) {
                            if (response.success) {
                                swal("Éxito", "Documento eliminado exitosamente.", "success").then(() => {
                                    location.reload();
                                });
                            } else {
                                swal("Error", response.message || "Error al eliminar el documento.", "error");
                            }
                        },
                        error: function () {
                            swal("Error", "Ha ocurrido un problema al eliminar el documento.", "error");
                        }
                    });
                }
            });
        }
    </script>
}
