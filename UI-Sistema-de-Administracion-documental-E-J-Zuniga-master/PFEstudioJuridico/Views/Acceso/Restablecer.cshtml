@{
    Layout = null;
}

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Restablecer cuenta | Estudio Jurídico</title>
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
    <link href="~/css/law-firm-theme.css" asp-append-version="true" rel="stylesheet">
</head>

<body class="bg-gradient-info lf-login">
    <div class="container lf-login-wrap">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10 col-md-7">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 offset-lg-3">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Restablecer cuenta</h1>
                                    </div>
                                    @if (ViewBag.Restablecido == null)

                                    {
                                        <form action="@Url.Action("Restablecer", "Acceso")" method="post" class="user">
                                            <p>Ingrese su dirección de correo electrónico y le enviaremos un enlace para restablecer su contraseña.</p>
                                            <div class="form-group">
                                                <input type="email" class="form-control form-control-user" placeholder="Correo" name="correo" value="@(ViewBag.Correo != null ? ViewBag.Correo : "")" required />
                                            </div>
                                            @if (ViewBag.Error != null)

                                            {
                                                <div class="form-group">
                                                    <div class="alert alert-danger" role="alert">
                                                        @ViewBag.Error
                                                    </div>
                                                </div>
                                            }
                                            <button type="submit" class="btn btn-primary btn-user btn-block">
                                                Restablecer
                                            </button>
                                        </form>


                                    }

                                    else

                                    {
                                        <div class="alert alert-success">
                                            <p>Su contraseña fue restablecida, le enviamos un mensaje a su correo para restablecer.</p>
                                            <a class="btn btn-success" href="@Url.Action("Login","Acceso")">Ingresar</a>
                                        </div>
                                    }
                                    <hr>
                                    <div class="text-center">
                                        <a class="small" asp-controller="Acceso" asp-action="Login">Volver</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
