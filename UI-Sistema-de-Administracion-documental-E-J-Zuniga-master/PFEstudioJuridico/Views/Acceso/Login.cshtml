@model PFEstudioJuridico.ViewModels.LoginVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Estudio Juridico - Login</title>
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
    <link href="~/css/law-firm-theme.css" asp-append-version="true" rel="stylesheet">
    <style>
        /* Estilo del overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.8);
            display: none; /* Ocultamos por defecto */
            align-items: center; /* Centrar verticalmente */
            justify-content: center; /* Centrar horizontalmente */
            z-index: 1000; /* Asegura que esté por encima de otros elementos */
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
            margin-bottom: 10px; /* Espaciado inferior */
        }

        .loading-text {
            font-size: 1.5rem; /* Ajusta el tamaño del texto */
            color: #007bff; /* Color del texto */
        }

        /* Estilo para centrar el contenido del overlay */
        .loading-overlay .d-flex {
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            height: 100%; /* Asegura que ocupe toda la altura del overlay */
        }
    </style>
</head>
<body class="bg-gradient-info lf-login">
    <div class="loading-overlay" id="loadingOverlay">
        <div class="d-flex">
            <div class="spinner-border" role="status">
                <span class="visually-hidden"></span>
            </div>
            <p class="loading-text">Cargando...</p>
        </div>
    </div>

    <div class="container lf-login-wrap">
        <div class="row justify-content-center w-100">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-2">Bienvenido</h1>
                                        <p class="lf-subtitle">Acceda al sistema de administración documental</p>
                                    </div>
                                    <form asp-controller="Acceso" asp-action="Login" method="post" class="user" id="loginForm">
                                        <div class="form-group">
                                            <input type="email" class="form-control form-control-user" placeholder="Correo" asp-for="correo" required>
                                        </div>
                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user" placeholder="Contraseña" asp-for="clave" required>
                                        </div>
@*                                         <div class="form-group">
                                            <div class="custom-control custom-checkbox small">
                                                <input type="checkbox" class="custom-control-input" id="chkMantenerSesion">
                                                <label class="custom-control-label" for="chkMantenerSesion">Mantener Sesión</label>
                                            </div>
                                        </div> *@

                                        @if (ViewData["Mensaje"] != null)
                                        {
                                            <div class="form-group">
                                                <div class="alert alert-danger" role="alert">
                                                    @ViewData["Mensaje"]
                                                </div>
                                            </div>
                                        }

                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            Ingresar
                                        </button>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a class="small" asp-controller="Acceso" asp-action="Restablecer">¿Olvidó su contraseña?</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#loginForm").submit(function (event) {
                // Mostrar el overlay
                $("#loadingOverlay").show();
            });
        });
    </script>
</body>
</html>
