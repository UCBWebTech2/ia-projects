@using PFEstudioJuridico.DTOs
@model List<UsuarioDTO2>

@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <style>
        .table-filters .form-control { min-width: 160px; }
        .dataTables_wrapper .dataTables_filter input { margin-left: .5em; }
    </style>
}

<!-- Mensajes de alerta -->
<div id="alert-container" class="mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }
</div>

<!-- Tabla de usuarios -->
<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-white">Lista de Usuarios</h6>
        <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#modalData" onclick="nuevoUsuario()">
            <i class="fas fa-plus-circle"></i> Nuevo Usuario
        </button>
    </div>
    <div class="card-body">
        <div class="row table-filters mb-3">
            <div class="col-md-4 mb-2">
                <label class="small font-weight-bold mb-1" for="filtroRol">Filtrar por rol</label>
                <select id="filtroRol" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Abogado">Abogado</option>
                </select>
            </div>
            <div class="col-md-4 mb-2">
                <label class="small font-weight-bold mb-1" for="filtroEstado">Filtrar por estado</label>
                <select id="filtroEstado" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    <option value="Habilitado">Habilitado</option>
                    <option value="Deshabilitado">Deshabilitado</option>
                </select>
            </div>
            <div class="col-md-4 mb-2 d-flex align-items-end">
                <button type="button" id="btnLimpiarFiltrosUsuario" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-eraser"></i> Limpiar filtros
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Habilitado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.NombreUsuario</td>
                                <td>@usuario.CorreoElectronico</td>
                                <td>@usuario.Rol</td>
                                <td>
                                    @if (usuario.Confirmado)
                                    {
                                        <span class="badge badge-info">Habilitado</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Deshabilitado</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#modalActualizar"
                                            onclick="cargarDatosActualizar(@usuario.IdUsuario, '@usuario.NombreUsuario', '@usuario.CorreoElectronico', '@usuario.Rol', @usuario.Confirmado.ToString().ToLower())">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="CambiarEstadoConfirmado" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@usuario.IdUsuario" />
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            <i class="fas fa-exchange-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">No hay usuarios disponibles.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Modal para Crear/Editar Usuario -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6>Detalle Usuario</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="usuarioForm" asp-controller="Usuario" asp-action="RegistrarUsuario" method="post">
                    <input type="hidden" value="0" id="txtId" name="IdUsuario">
                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="txtNombre">Nombre del Usuario</label>
                            <input type="text" class="form-control form-control-sm" id="txtNombre" name="NombreUsuario" required>
                        </div>
                        <div class="form-group col-sm-12">
                            <label for="txtCorreo">Correo Electrónico</label>
                            <input type="email" class="form-control form-control-sm" id="txtCorreo" name="CorreoElectronico" required>
                        </div>
                        <div class="form-group col-sm-12">
                            <label for="txtRol">Rol</label>
                            <select class="form-control form-control-sm" id="txtRol" name="Rol" required>
                                <option value="Seleccione" disabled selected>Seleccione un rol</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Abogado">Abogado</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal para Actualizar Usuario -->
<div class="modal fade" id="modalActualizar" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6>Actualizar Usuario</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="actualizarUsuarioForm" asp-controller="Usuario" asp-action="ActualizarUsuario" method="post">
                    <input type="hidden" id="updateIdUsuario" name="IdUsuario">

                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="updateNombreUsuario">Nombre del Usuario</label>
                            <input type="text" class="form-control form-control-sm" id="updateNombreUsuario" name="NombreUsuario" required>
                        </div>
                    </div>
                    <input type="hidden" id="updateCorreoElectronico" name="CorreoElectronico">
                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="updateHabilitado">Estado</label>
                            <select class="form-control form-control-sm" id="updateHabilitado" name="Confirmar" required>
                                <option value="true">Habilitado</option>
                                <option value="false">Deshabilitado</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="updateRol">Rol</label>
                            <select class="form-control form-control-sm" id="updateRol" name="Rol" required>
                                <option value="Seleccione" disabled selected>Seleccione un rol</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Abogado">Abogado</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-sm">Actualizar</button>
                        <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>


@section scripts {
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert").fadeOut("slow");
            }, 5000);

            var table = $('#tbdata').DataTable({
                paging: true,
                lengthMenu: [10, 25, 50, 75, 100],
                pageLength: 10,
                responsive: true,
                order: [[0, 'asc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    zeroRecords: "No se encontraron registros",
                    info: "Mostrando página _PAGE_ de _PAGES_",
                    infoEmpty: "No hay registros disponibles",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                }
            });

            $('#filtroRol').on('change', function () {
                table.column(2).search(this.value).draw();
            });
            $('#filtroEstado').on('change', function () {
                table.column(3).search(this.value).draw();
            });
            $('#btnLimpiarFiltrosUsuario').on('click', function () {
                $('#filtroRol, #filtroEstado').val('');
                table.columns().search('').draw();
            });
        });

        $('#modalData').on('hidden.bs.modal', function () {
            $('#usuarioForm')[0].reset();
            $('#txtId').val('0');
        });
        $('#modalActualizar').on('hidden.bs.modal', function () {
            $('#actualizarUsuarioForm')[0].reset();
            $('#updateIdUsuario').val('');
        });
        function cargarDatosActualizar(id, nombre, correo, rol, confirmado) {
            $('#updateIdUsuario').val(id);
            $('#updateNombreUsuario').val(nombre);
            $('#updateCorreoElectronico').val(correo);
            $('#updateRol').val(rol).change();
            $('#updateHabilitado').val(confirmado.toString().toLowerCase()).change();
            $('.modal-header h6').text('Actualizar Usuario');
        }

        function nuevoUsuario() {
            $('#txtId').val("");
            $('#txtNombre').val("");
            $('#txtCorreo').val("");
            $('#txtRol').val("");
            $('.modal-header h6').text('Nuevo Usuario');
        }
    </script>
}